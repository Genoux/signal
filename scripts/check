#!/usr/bin/env bash
# The one health check (R5). CI runs exactly this.
# Runs package.json's "check" script if it has one; otherwise whichever of
# format:check, lint, typecheck and test it defines.
set -euo pipefail
cd "$(dirname "$0")/.."

if   [ -f bun.lock ] || [ -f bun.lockb ]; then pm=bun;  install="bun install --frozen-lockfile"
elif [ -f pnpm-lock.yaml ];                then pm=pnpm; install="pnpm install --frozen-lockfile"
elif [ -f package-lock.json ];             then pm=npm;  install="npm ci"
else                                            pm=npm;  install="npm install"
fi
[ -f package.json ] || { echo "no package.json yet: nothing to check" >&2; exit 0; }
$install

has() { node -e "process.exit(require('./package.json').scripts?.['$1'] ? 0 : 1)" 2>/dev/null \
     || bun -e "process.exit(require('./package.json').scripts?.['$1'] ? 0 : 1)" 2>/dev/null; }

if has check; then $pm run check; exit; fi
ran=0
for s in format:check lint typecheck test; do
  if has "$s"; then $pm run "$s"; ran=1; fi
done
[ "$ran" = 1 ] || echo "package.json defines none of check, format:check, lint, typecheck, test" >&2
